# Copia este archivo a ".env" y ajusta los valores.

PORT=3000
# URL pública del sitio (la usa WhatsApp para descargar el boleto y los enlaces de los correos)
PUBLIC_URL=http://localhost:3000

# Administrador (se crea la primera vez que arranca el servidor)
ADMIN_USER=admin
ADMIN_PASS=Dokan123

# Código de país para teléfonos de 8 dígitos (Guatemala = 502)
DEFAULT_COUNTRY_CODE=502

# Datos bancarios que verá el cliente al enviar su solicitud
BANK_NAME=Banco Industrial
BANK_ACCOUNT_TYPE=Monetaria
BANK_ACCOUNT=0000000-0
BANK_HOLDER=Nombre del titular

# Correo (SMTP). Si lo dejas vacío, los correos se escriben en la consola y en data/outbox.log
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=tucorreo@gmail.com SMTP_PASS=contraseña_de_aplicacion
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DOKAN Tickets <tucorreo@gmail.com>"

# WhatsApp: none | twilio | meta
#  - none:   el admin ve un botón "Enviar por WhatsApp" (abre wa.me con el boleto)
#  - twilio: envío automático con imagen (necesita Twilio WhatsApp)
#  - meta:   envío automático con WhatsApp Cloud API
WHATSAPP_PROVIDER=none
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
META_TOKEN=
META_PHONE_ID=

# ---------------------------------------------------------------------------
# Cuentas iniciales (se crean UNA sola vez, solo si el correo no existe; nunca se restablece una contraseña existente).
# Deja las contraseñas vacías si no quieres crear la cuenta. NO subas el archivo .env a un repositorio público.
# Roles: ADMIN, USER, TAQUILLA (solo escáner) y PANEL (solo panel de vendidas/utilizadas). ADMIN y TAQUILLA deberán cambiar su contraseña en el primer ingreso
# (pon SEED_FORCE_PW_CHANGE=0 para desactivarlo).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_TAQUILLA_EMAIL=
SEED_TAQUILLA_PASSWORD=
SEED_PANEL_EMAIL=
SEED_PANEL_PASSWORD=
SEED_FORCE_PW_CHANGE=1

# Número de WhatsApp al que los compradores envían su comprobante de pago (sin código de país).
PROOF_PHONE=35962132
# Máximo de solicitudes en revisión por usuario
MAX_OPEN_ORDERS=5


